{
  "schemaVersion": 1,
  "plugin": "RandomAuctionAddon",
  "version": "1.0.3",
  "minJava": "21",
  "maxServerTested": "1.21.6",
  "rules": [
    {
      "id": "require-min-java",
      "match": {
        "java": "<21"
      },
      "severity": "block",
      "message": "Java 21+ is required. Please upgrade your server's Java version."
    },
    {
      "id": "server-newer-than-tested",
      "match": {
        "mc": ">1.21.6"
      },
      "severity": "warn",
      "message": "Server version is newer than tested (tested up to 1.21.6). Things may work but report any issues."
    },
    {
      "id": "update-available",
      "match": {
        "pluginVersion": "<1.0.3"
      },
      "severity": "info",
      "message": "Update available: 1.0.3"
    }
  ]
}
